{
  "expo": {
    "name": "AYWO",
    "slug": "aywo",
    "scheme": "aywo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.aywo.app",
      "supportsTablet": true,
      "associatedDomains": ["applinks:aywo.in"],
      "infoPlist": {
        "UIBackgroundModes": ["location", "remote-notification"],
        "NSContactsUsageDescription": "AYWO reads a contact only when you choose one, to fill in a relative's name and number or to invite them.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.aywo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/adaptive-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "aywo.in", "pathPrefix": "/link" },
            { "scheme": "https", "host": "aywo.in", "pathPrefix": "/social/groups/join" },
            { "scheme": "https", "host": "aywo.in", "pathPrefix": "/invite" },
            { "scheme": "https", "host": "aywo.in", "pathPrefix": "/social/sos/watch" },
            { "scheme": "https", "host": "aywo.in", "pathPrefix": "/help" },
            { "scheme": "https", "host": "aywo.in", "pathPrefix": "/offers" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECORD_AUDIO",
        "CALL_PHONE",
        "READ_CONTACTS"
      ]
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      ["expo-localization", { "supportsRTL": true }],
      "expo-secure-store",
      "expo-font",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#8E26E1", "sounds": ["./assets/sounds/sos_alarm.wav"] }],
      [
        "expo-splash-screen",
        { "image": "./assets/splash-mark.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#FCFBFF" }
      ],
      "expo-task-manager",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "During an SOS, AYWO shares your location with the contacts you chose, even when your phone is locked, until you stop it.",
          "locationWhenInUsePermission": "During an SOS, AYWO shares your location with the contacts you chose.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-audio",
        { "microphonePermission": "AYWO uses the microphone only while you record a voice note." }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AYWO uses your photos only when you choose one for a person, a memory or a chat.",
          "cameraPermission": "AYWO uses the camera only when you take a photo for a person, a memory or a chat."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" } }
  }
}
