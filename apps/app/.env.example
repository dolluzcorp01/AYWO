# Expo reads .env from this folder, not from the repo root. Copy this file to apps/app/.env for local runs.
# These ship inside the app, so never put a secret here.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:8081
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_dummy
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_dummy
