{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": {
      "@aywo/shared": ["./packages/shared/src/index.ts"],
      "@aywo/kinship": ["./packages/kinship/src/index.ts"],
      "@aywo/lighten": ["./packages/lighten/src/index.ts"],
      "@aywo/layout": ["./packages/layout/src/index.ts"]
    }
  }
}
