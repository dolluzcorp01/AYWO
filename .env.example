# Copy to .env. Every outside service starts on a dummy value: replace them when connecting each one.
# Real keys are never committed.

# ===== App (Expo reads EXPO_PUBLIC_ values; they ship inside the app, so never put a secret here) =====
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:8081
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_dummy
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_dummy
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_dummy

# ===== API server =====
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:8081

# DigitalOcean managed Postgres, with DATABASE_SSL=true in production. Use the DIRECT connection, not a
# transaction-mode pool: chat uses LISTEN/NOTIFY, which a pool drops.
DATABASE_URL=postgres://aywo:aywo@localhost:5432/aywo
DATABASE_SSL=false

# Long random values. For example: openssl rand -base64 48
JWT_SECRET=dummy-replace-with-at-least-32-random-characters
OTP_SECRET=dummy-replace-with-random-characters

# A fixed login for Apple and Google reviewers. Leave empty unless a review is running.
OTP_TEST_PHONE=
OTP_TEST_CODE=
# In production the reviewers' login works only until this moment, for example 2027-01-31T00:00:00Z.
OTP_TEST_UNTIL=

# The header the platform's proxy sets to the visitor's address; rate limits count by it. DigitalOcean App Platform: this
# value (confirm on first deploy). A bare Droplet with nothing in front: leave EMPTY, or limits can be escaped.
CLIENT_IP_HEADER=do-connecting-ip

# ===== SMS: console (prints, development only), msg91 or twilio =====
SMS_PROVIDER=console
MSG91_AUTH_KEY=dummy
MSG91_TEMPLATE_ID=dummy
TWILIO_ACCOUNT_SID=dummy
TWILIO_AUTH_TOKEN=dummy
TWILIO_FROM=dummy

# ===== Email: SendGrid =====
SENDGRID_API_KEY=SG.dummy
EMAIL_FROM=hello@aywo.in
EMAIL_FROM_NAME=AYWO

# ===== Files: DigitalOcean Spaces =====
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_REGION=blr1
SPACES_BUCKET=aywo
SPACES_KEY=dummy
SPACES_SECRET=dummy

# ===== Payments: Razorpay (India web: UPI, debit, credit) =====
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy
RAZORPAY_WEBHOOK_SECRET=dummy
RAZORPAY_PLAN_MONTHLY=plan_dummy_monthly
RAZORPAY_PLAN_YEARLY=plan_dummy_yearly

# ===== Payments: Stripe (overseas web: cards, Apple Pay on Safari) =====
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_PRICE_MONTHLY=price_dummy_monthly
STRIPE_PRICE_YEARLY=price_dummy_yearly

# ===== Payments: RevenueCat (Apple and Google billing inside the apps) =====
REVENUECAT_WEBHOOK_AUTH=dummy

# ===== Staff second sign-in step (authenticator app) =====
# Production always requires it. Leave unset. 'off' only in an emergency, 'required' to test it locally.
# STAFF_TWO_STEP=
# Seals staff authenticator secrets. Set 32+ random characters in production; changing it later means staff set up again.
# STAFF_SECRET_KEY=

# ===== Translating the app and seeding relationship words (scripts/, not the running server) =====
ANTHROPIC_API_KEY=dummy

# Optional: full path to a real .lighten.zip for test T-IO-01 (skipped when empty)
AYWO_LIGHTEN_SAMPLE=
